# PostgreSQL exclusivo del entorno Web de testing
POSTGRES_DB=mismascotas_web_testing
POSTGRES_USER=mismascotas_web_testing
POSTGRES_PASSWORD=reemplazar_con_una_clave_de_testing

# Conexión interna del backend. Mantener el host db-web-testing.
DB_URL=jdbc:postgresql://db-web-testing:5432/mismascotas_web_testing
DB_USERNAME=mismascotas_web_testing
DB_PASSWORD=reemplazar_con_la_misma_clave_de_testing

# Autenticación. Reemplazar por un secreto aleatorio de al menos 32 caracteres.
JWT_SECRET=reemplazar_con_un_secreto_de_testing_de_al_menos_32_caracteres
JWT_ACCESS_TOKEN_EXPIRATION_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRATION_DAYS=14
JWT_PRE_AUTH_EXPIRATION_MINUTES=10
AUTH_CODIGO_VERIFICACION_EXPIRACION_MINUTOS=10
JPA_SHOW_SQL=false

# SMTP necesario para recibir el código de 2FA.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS_ENABLE=true
MAIL_SMTP_STARTTLS_REQUIRED=true
