      "request": {
        "description": "Antes de ejecutar este request, cargar la variable codigo con el codigo generado en la tabla codigo_verificacion.",
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"usuarioId\": \"{{usuarioId}}\",\n  \"codigo\": \"{{codigo}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/auth/login/verificar-codigo",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "login",
            "verificar-codigo"
          ]
        }
