        {
          "name": "05 - Logout dispositivo A - 204",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 204', () => pm.response.to.have.status(204));",
                  "pm.collectionVariables.set('refreshTokenRevocado', pm.collectionVariables.get('refreshTokenDispositivoA'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
