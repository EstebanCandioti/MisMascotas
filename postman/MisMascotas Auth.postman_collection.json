{
  "info": {
    "name": "MisMascotas - Auth (CU1 + CU2 2FA)",
    "description": "Tests basicos de AuthController: registro, login con token pre-auth, verificacion de codigo 2FA y acceso a endpoint protegido. Correr en orden. Para verificar codigo, copiar el codigo recibido por email en la variable codigo antes de ejecutar el request correspondiente.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8080", "type": "string" },
    { "key": "email", "value": "", "type": "string" },
    { "key": "password", "value": "Test1234", "type": "string" },
    { "key": "preAuthToken", "value": "", "type": "string" },
    { "key": "sessionToken", "value": "", "type": "string" },
    { "key": "codigo", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "CU1 - Registrarse",
      "item": [
        {
          "name": "01 - Registrar usuario - 200",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const email = `test_${Date.now()}@mismascotas.test`;",
                  "pm.collectionVariables.set('email', email);",
                  "pm.collectionVariables.set('password', 'Test1234');",
                  "pm.collectionVariables.unset('preAuthToken');",
                  "pm.collectionVariables.unset('sessionToken');",
                  "pm.collectionVariables.unset('codigo');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Devuelve JWT de sesion Bearer', () => {",
                  "    pm.expect(body.token).to.be.a('string').and.not.empty;",
                  "    pm.expect(body.tipo).to.eql('Bearer');",
                  "});",
                  "pm.collectionVariables.set('sessionToken', body.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Usuario de Prueba\",\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": { "raw": "{{base_url}}/auth/register", "host": ["{{base_url}}"], "path": ["auth", "register"] }
          }
        },
        {
          "name": "02 - Registrar con email duplicado - 409",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 409', () => pm.response.to.have.status(409));",
                  "const body = pm.response.json();",
                  "pm.test('ERROR_NEGOCIO por email duplicado', () => {",
                  "    pm.expect(body.codigo).to.eql('ERROR_NEGOCIO');",
                  "    pm.expect(body.mensaje).to.include('ya esta registrado');",
                  "    pm.expect(body).to.have.property('timestamp');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Usuario Duplicado\",\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": { "raw": "{{base_url}}/auth/register", "host": ["{{base_url}}"], "path": ["auth", "register"] }
          }
        },
        {
          "name": "03 - Registrar con campos vacios - 400",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 400', () => pm.response.to.have.status(400));",
                  "const body = pm.response.json();",
                  "pm.test('ERROR_VALIDACION con un error por campo', () => {",
                  "    pm.expect(body.codigo).to.eql('ERROR_VALIDACION');",
                  "    pm.expect(body.mensaje).to.include('nombre:');",
                  "    pm.expect(body.mensaje).to.include('email:');",
                  "    pm.expect(body.mensaje).to.include('password:');",
                  "    pm.expect((body.mensaje.match(/password:/g) || []).length).to.eql(1);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"\",\n  \"email\": \"\",\n  \"password\": \"\"\n}"
            },
            "url": { "raw": "{{base_url}}/auth/register", "host": ["{{base_url}}"], "path": ["auth", "register"] }
          }
        }
      ]
    },
    {
      "name": "CU2 - Login 2FA",
      "item": [
        {
          "name": "01 - Login credenciales correctas devuelve pre-auth - 200",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Devuelve token pre-auth Bearer y mensaje', () => {",
                  "    pm.expect(body.token).to.be.a('string').and.not.empty;",
                  "    pm.expect(body.tipo).to.eql('Bearer');",
                  "    pm.expect(body.mensaje).to.eql('Codigo de verificacion enviado');",
                  "});",
                  "pm.collectionVariables.set('preAuthToken', body.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": { "raw": "{{base_url}}/auth/login", "host": ["{{base_url}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "02 - Token pre-auth no accede a endpoint protegido - 401 o 403",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 401 o 403', () => pm.expect([401, 403]).to.include(pm.response.code));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [ { "key": "Authorization", "value": "Bearer {{preAuthToken}}" } ],
            "url": { "raw": "{{base_url}}/usuario/me", "host": ["{{base_url}}"], "path": ["usuario", "me"] }
          }
        },
        {
          "name": "03 - Verificar codigo correcto - 200",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.collectionVariables.get('codigo')) {",
                  "    throw new Error('Carga la variable de coleccion codigo con el codigo recibido por email antes de ejecutar este request.');",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Devuelve JWT final Bearer', () => {",
                  "    pm.expect(body.token).to.be.a('string').and.not.empty;",
                  "    pm.expect(body.tipo).to.eql('Bearer');",
                  "});",
                  "pm.collectionVariables.set('sessionToken', body.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{preAuthToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"codigo\": \"{{codigo}}\"\n}"
            },
            "url": { "raw": "{{base_url}}/auth/verificar-codigo", "host": ["{{base_url}}"], "path": ["auth", "verificar-codigo"] }
          }
        },
        {
          "name": "04 - Reutilizar codigo usado debe fallar - 400",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 400', () => pm.response.to.have.status(400));",
                  "const body = pm.response.json();",
                  "pm.test('CODIGO_INVALIDO', () => {",
                  "    pm.expect(body.codigo).to.eql('CODIGO_INVALIDO');",
                  "    pm.expect(body.mensaje).to.eql('El codigo no es valido');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{preAuthToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"codigo\": \"{{codigo}}\"\n}"
            },
            "url": { "raw": "{{base_url}}/auth/verificar-codigo", "host": ["{{base_url}}"], "path": ["auth", "verificar-codigo"] }
          }
        },
        {
          "name": "05 - Acceder a /usuario/me con JWT final - 200",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Devuelve perfil del usuario', () => {",
                  "    pm.expect(body.email).to.eql(pm.collectionVariables.get('email'));",
                  "    pm.expect(body.nombre).to.be.a('string').and.not.empty;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [ { "key": "Authorization", "value": "Bearer {{sessionToken}}" } ],
            "url": { "raw": "{{base_url}}/usuario/me", "host": ["{{base_url}}"], "path": ["usuario", "me"] }
          }
        },
        {
          "name": "06 - Verificar codigo sin token pre-auth - 400",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 400', () => pm.response.to.have.status(400));",
                  "const body = pm.response.json();",
                  "pm.test('ERROR_NEGOCIO por token faltante', () => {",
                  "    pm.expect(body.codigo).to.eql('ERROR_NEGOCIO');",
                  "    pm.expect(body.mensaje).to.eql('Token de verificacion invalido');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"codigo\": \"123456\"\n}"
            },
            "url": { "raw": "{{base_url}}/auth/verificar-codigo", "host": ["{{base_url}}"], "path": ["auth", "verificar-codigo"] }
          }
        },
        {
          "name": "07 - Login password incorrecta - 401",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 401', () => pm.response.to.have.status(401));",
                  "const body = pm.response.json();",
                  "pm.test('Mensaje generico', () => {",
                  "    pm.expect(body.codigo).to.eql('NO_AUTENTICADO');",
                  "    pm.expect(body.mensaje).to.eql('Credenciales invalidas');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"PasswordIncorrecta1\"\n}"
            },
            "url": { "raw": "{{base_url}}/auth/login", "host": ["{{base_url}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "08 - Login campos vacios - 400",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 400', () => pm.response.to.have.status(400));",
                  "const body = pm.response.json();",
                  "pm.test('ERROR_VALIDACION', () => {",
                  "    pm.expect(body.codigo).to.eql('ERROR_VALIDACION');",
                  "    pm.expect(body.mensaje).to.include('email:');",
                  "    pm.expect(body.mensaje).to.include('password:');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"\",\n  \"password\": \"\"\n}"
            },
            "url": { "raw": "{{base_url}}/auth/login", "host": ["{{base_url}}"], "path": ["auth", "login"] }
          }
        }
      ]
    }
  ]
}