{
  "info": {
    "_postman_id": "8f3f3997-c9b8-4d0c-a6f2-5ed52fd52e85",
    "name": "MisMascotas - Auth Basico",
    "description": "Coleccion basica para probar Auth, JWT y endpoint protegido de usuario.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 - Register OK",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "if (!pm.collectionVariables.get('testEmail')) {",
              "    pm.collectionVariables.set('testEmail', `test_${Date.now()}@mismascotas.com`);",
              "}",
              "if (!pm.collectionVariables.get('testPassword')) {",
              "    pm.collectionVariables.set('testPassword', 'Password123');",
              "}"
            ],
            "type": "text/javascript"
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "const json = pm.response.json();",
              "",
              "pm.test('Devuelve token Bearer', function () {",
              "    pm.expect(json).to.have.property('token').that.is.a('string').and.is.not.empty;",
              "    pm.expect(json).to.have.property('tipo', 'Bearer');",
              "});",
              "",
              "if (json.token) {",
              "    pm.collectionVariables.set('token', json.token);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Usuario Test\",\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/auth/register",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "register"
          ]
        }
      },
      "response": []
    },
    {
      "name": "02 - Register Duplicado debe fallar",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 409 Conflict o 400 Bad Request', function () {",
              "    pm.expect([400, 409]).to.include(pm.response.code);",
              "});",
              "",
              "pm.test('Devuelve respuesta de error', function () {",
              "    const json = pm.response.json();",
              "    pm.expect(json).to.be.an('object');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Usuario Test\",\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/auth/register",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "register"
          ]
        }
      },
      "response": []
    },
    {
      "name": "03 - Login OK envia codigo",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "const json = pm.response.json();",
              "",
              "pm.test('Devuelve usuarioId y mensaje', function () {",
              "    pm.expect(json).to.have.property('usuarioId').that.is.a('string').and.is.not.empty;",
              "    pm.expect(json).to.have.property('mensaje').that.is.a('string').and.is.not.empty;",
              "});",
              "",
              "if (json.usuarioId) {",
              "    pm.collectionVariables.set('usuarioId', json.usuarioId);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
