{
  "info": {
    "name": "MisMascotas - Auth (CU1 + CU2 2FA + Refresh)",
    "description": "Colección especializada para el flujo Auth actual: registro/login con preautenticación, 2FA, access token, refresh token rotativo, logout y múltiples dispositivos. Configurar email, password y el último código recibido por email. No contiene credenciales ni tokens reales.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "email",
      "value": "",
      "type": "string"
    },
    {
      "key": "password",
      "value": "",
      "type": "string"
    },
    {
      "key": "codigo",
      "value": "",
      "type": "string"
    },
    {
      "key": "preAuthToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "refreshToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "oldRefreshToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "refreshTokenDispositivoA",
      "value": "",
      "type": "string"
    },
    {
      "key": "refreshTokenDispositivoB",
      "value": "",
      "type": "string"
    },
    {
      "key": "accessTokenDispositivoB",
      "value": "",
      "type": "string"
    },
    {
      "key": "refreshTokenRevocado",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Registro y acceso",
      "item": [
        {
          "name": "01 - Registrar usuario devuelve pre-auth - 200",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.variables.get('email')) throw new Error('Configura email con una casilla que pueda recibir el código 2FA.');",
                  "if (!pm.variables.get('password')) throw new Error('Configura password (mínimo 8 caracteres, una mayúscula y un número).');",
                  "['codigo','preAuthToken','accessToken','refreshToken','oldRefreshToken','refreshTokenDispositivoA','refreshTokenDispositivoB','accessTokenDispositivoB','refreshTokenRevocado'].forEach(k => pm.collectionVariables.unset(k));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Devuelve token pre-auth, no sesion', () => {",
                  "  pm.expect(body.token).to.be.a('string').and.not.empty;",
                  "  pm.expect(body.tipo).to.eql('Bearer');",
                  "  pm.expect(body.mensaje).to.eql('Codigo de verificacion enviado');",
                  "  pm.expect(body).to.not.have.property('accessToken');",
                  "  pm.expect(body).to.not.have.property('refreshToken');",
                  "});",
                  "pm.collectionVariables.set('preAuthToken', body.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Usuario de Prueba\",\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            }
          }
        },
        {
          "name": "02 - Acceso a /usuario/me sin token - 401",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 401', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/usuario/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "usuario",
                "me"
              ]
            }
          }
        },
        {
          "name": "03 - Token pre-auth no accede a /usuario/me - 401",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 401', () => pm.response.to.have.status(401));",
                  "const body = pm.response.json();",
                  "pm.test('NO_AUTENTICADO', () => pm.expect(body.codigo).to.eql('NO_AUTENTICADO'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{preAuthToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/usuario/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "usuario",
                "me"
              ]
            }
          }
        },
        {
          "name": "04 - Verificar codigo de registro devuelve access + refresh - 200",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.variables.get('codigo')) throw new Error('Carga la variable codigo con el ultimo codigo recibido por email antes de ejecutar este request.');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Devuelve par de tokens', () => {",
                  "  pm.expect(body.accessToken).to.be.a('string').and.not.empty;",
                  "  pm.expect(body.refreshToken).to.be.a('string').and.not.empty;",
                  "  pm.expect(body.tipo).to.eql('Bearer');",
                  "  pm.expect(body.accessTokenExpiraEn).to.be.a('string').and.not.empty;",
                  "});",
                  "pm.collectionVariables.set('accessToken', body.accessToken);",
                  "pm.collectionVariables.set('refreshToken', body.refreshToken);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{preAuthToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"codigo\": \"{{codigo}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/verificar-codigo",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "verificar-codigo"
              ]
            }
          }
        },
        {
          "name": "05 - Acceder a /usuario/me con access token - 200",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Perfil autenticado', () => pm.expect(body.email).to.eql(pm.variables.get('email')));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/usuario/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "usuario",
                "me"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Refresh rotativo",
      "item": [
        {
          "name": "01 - Renovar con refresh valido rota token - 200",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "const anterior = pm.collectionVariables.get('refreshToken');",
                  "pm.test('Devuelve nuevo par de tokens', () => {",
                  "  pm.expect(body.accessToken).to.be.a('string').and.not.empty;",
                  "  pm.expect(body.refreshToken).to.be.a('string').and.not.empty;",
                  "  pm.expect(body.refreshToken).to.not.eql(anterior);",
                  "});",
                  "pm.collectionVariables.set('oldRefreshToken', anterior);",
                  "pm.collectionVariables.set('accessToken', body.accessToken);",
                  "pm.collectionVariables.set('refreshToken', body.refreshToken);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/refresh",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "refresh"
              ]
            }
          }
        },
        {
          "name": "02 - Reutilizar refresh rotado revoca sesiones activas - 401",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 401', () => pm.response.to.have.status(401));",
                  "const body = pm.response.json();",
                  "pm.test('NO_AUTENTICADO', () => pm.expect(body.codigo).to.eql('NO_AUTENTICADO'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{oldRefreshToken}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/refresh",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "refresh"
              ]
            }
          }
        },
        {
          "name": "03 - Renovar con refresh inexistente - 401",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 401', () => pm.response.to.have.status(401));",
                  "const body = pm.response.json();",
                  "pm.test('NO_AUTENTICADO', () => pm.expect(body.codigo).to.eql('NO_AUTENTICADO'));",
                  "pm.test('No revela existencia del token', () => pm.expect(body.mensaje).to.eql('Refresh token invalido'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"refresh-token-inexistente\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/refresh",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "refresh"
              ]
            }
          }
        }
      ]
    },
