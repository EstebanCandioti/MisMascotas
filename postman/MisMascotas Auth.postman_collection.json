    {
      "name": "05 - Verificar codigo 2FA OK manual",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "const json = pm.response.json();",
              "",
              "pm.test('Devuelve token Bearer', function () {",
              "    pm.expect(json).to.have.property('token').that.is.a('string').and.is.not.empty;",
              "    pm.expect(json).to.have.property('tipo', 'Bearer');",
              "});",
              "",
              "if (json.token) {",
              "    pm.collectionVariables.set('token', json.token);",
              "}"
            ],
            "type": "text/javascript"
          }
