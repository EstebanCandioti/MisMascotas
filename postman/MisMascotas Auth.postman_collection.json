    {
      "name": "06 - Usuario me con token",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "const json = pm.response.json();",
              "",
              "pm.test('Devuelve perfil del usuario logueado', function () {",
              "    pm.expect(json).to.have.property('idUsuario').that.is.a('string').and.is.not.empty;",
              "    pm.expect(json).to.have.property('email', pm.collectionVariables.get('testEmail'));",
              "    pm.expect(json).to.have.property('nombre').that.is.a('string').and.is.not.empty;",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/usuario/me",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "usuario",
            "me"
          ]
        }
