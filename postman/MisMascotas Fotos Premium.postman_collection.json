              "mode": "raw",
              "raw": "{\n  \"nombre\": \"No modificar\",\n  \"especie\": \"Perro\",\n  \"fechaNacimiento\": \"2020-01-01\",\n  \"fechaAproximada\": false,\n  \"pesoActual\": 12.5,\n  \"notas\": \"Notas de perfil QA\"\n}",
