    {
      "name": "Invitado — lectura y rechazo por permisos",
      "item": [
        {
          "name": "Invitado ve foto de propietario Free",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenInvitado}}"
              }
            ],
            "url": "{{baseUrl}}/mascotas/{{mascotaFreeId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP esperado: 200',()=>pm.expect(pm.response.code).to.equal(200));",
                  "pm.test('Conserva imagen previa',()=>pm.expect(pm.response.json().fotoPerfil).to.equal(pm.variables.get('fotoPerfilPrevia')));"
                ]
              }
            }
          ]
        },
        {
          "name": "Invitado no edita: ausencia",
