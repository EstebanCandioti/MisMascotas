  "item": [
    {
      "name": "Invitado — lectura sin gestión",
      "item": [
        {
          "name": "Lista badges de propietario Free",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenInvitado}}"
              }
            ],
            "url": "{{baseUrl}}/mascotas/{{mascotaFreeId}}/badges"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP esperado: 200',()=>pm.expect(pm.response.code).to.equal(200));",
                  "pm.test('Cantidad activa: 1',()=>pm.expect(pm.response.json()).to.have.lengthOf(1));"
                ]
              }
            }
          ]
        },
        {
          "name": "Consulta badge por ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenInvitado}}"
              }
            ],
            "url": "{{baseUrl}}/badges/{{badgeFreeId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP esperado: 200',()=>pm.expect(pm.response.code).to.equal(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "No crea aunque su cuenta sea Premium",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenInvitado}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/mascotas/{{mascotaFreeId}}/badges",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mascotaId\": \"{{mascotaFreeId}}\",\n  \"texto\": \"Sociable\",\n  \"emoji\": \"★\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP esperado: 403',()=>pm.expect(pm.response.code).to.equal(403));",
                  "pm.test('Código de error',()=>pm.expect(pm.response.json().codigo).to.equal('ACCESO_DENEGADO'));"
                ]
              }
            }
          ]
        },
        {
          "name": "No elimina badge compartida",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenInvitado}}"
              }
            ],
            "url": "{{baseUrl}}/badges/{{badgeFreeId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP esperado: 403',()=>pm.expect(pm.response.code).to.equal(403));",
                  "pm.test('Código de error',()=>pm.expect(pm.response.json().codigo).to.equal('ACCESO_DENEGADO'));"
                ]
              }
            }
          ]
        }
