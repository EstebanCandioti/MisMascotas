    {
      "name": "Premium — Creación, edición, carga y borrado lógico",
      "item": [
        {
          "name": "Crear álbum",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenPremium}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/mascotas/{{mascotaPremiumId}}/albumes",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Álbum nuevo\",\n  \"mascotaId\": \"{{mascotaPremiumId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP esperado: 201', () => pm.expect(pm.response.code).to.equal(201));",
                  "if(pm.response.code===201) pm.collectionVariables.set('albumNuevoId',pm.response.json().idAlbum);",
                  "pm.test('Contrato de álbum',()=>{const a=pm.response.json();pm.expect(a.nombre).to.equal('Álbum nuevo');pm.expect(a.mascotaId).to.equal(pm.variables.get('mascotaPremiumId'));pm.expect(a.cantidadFotos).to.equal(0);});"
                ]
              }
            }
          ]
        },
        {
          "name": "Editar álbum",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenPremium}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/albumes/{{albumNuevoId}}",
            "body": {
              "mode": "raw",
