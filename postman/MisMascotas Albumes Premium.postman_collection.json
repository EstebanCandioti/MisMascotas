  "item": [
    {
      "name": "Free — Consulta y rechazos sin modificación",
      "item": [
        {
          "name": "No crea álbum",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenFree}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/mascotas/{{mascotaFreeId}}/albumes",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"No crear\",\n  \"mascotaId\": \"{{mascotaFreeId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP esperado: 403', () => pm.expect(pm.response.code).to.equal(403));",
                  "pm.test('Código de rechazo', () => pm.expect(pm.response.json().codigo).to.equal('PREMIUM_REQUERIDO'));"
                ]
              }
            }
          ]
        },
